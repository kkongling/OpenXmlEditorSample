<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <!-- 引入 OpenXML SDK -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.3.0" />
    <!-- 以项目引用方式引入源生成器 -->
    <ProjectReference Include="..\Open-XML-SDK\gen\DocumentFormat.OpenXml.Generator\DocumentFormat.OpenXml.Generator.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
    <ProjectReference Include="..\Open-XML-SDK\gen\DocumentFormat.OpenXml.Generator.Models\DocumentFormat.OpenXml.Generator.Models.csproj"
                      PrivateAssets="all"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer" />
  </ItemGroup>

</Project>
